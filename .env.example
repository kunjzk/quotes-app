DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG_MODE=True
POSTGRES_NAME=quotesapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=quotes-postgres
POSTGRES_PORT=5432

# Email Configuration
# For local development with MailHog:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=quotes-mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@quotesapp.local

# For AWS SES (production):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-ses-smtp-username
# EMAIL_HOST_PASSWORD=your-ses-smtp-password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Celery Configuration
CELERY_BROKER_URL=redis://quotes-redis:6379